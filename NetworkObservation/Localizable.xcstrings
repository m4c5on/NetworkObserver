          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Браўзер па змаўчанні"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślna przeglądarka"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер по умолчанию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер за замовчуванням"
          }
        }
      }
    },
    "TLS error": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Памылка TLS"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd TLS"
          }
        },
        "ru": {
