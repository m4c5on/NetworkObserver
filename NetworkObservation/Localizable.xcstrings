    "A joke code from an April Fools' RFC; some servers use it to reject bots.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Жартоўны код з першакрасавіцкага RFC; некаторыя серверы адказваюць ім ботам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żartobliwy kod z prima aprilisowego RFC; niektóre serwery odpowiadają nim botom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шуточный код из первоапрельского RFC; некоторые серверы отвечают им ботам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жартівливий код із першоквітневого RFC; деякі сервери відповідають ним ботам."
          }
        }
      }
    },
    "A permanent redirect that keeps the same method and body.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пастаяннае перанакіраванне з тым жа метадам і целам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stałe przekierowanie z tą samą metodą i treścią."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянное перенаправление с тем же методом и телом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постійне перенаправлення з тим самим методом і тілом."
          }
        }
      }
    },
    "A proxy or gateway in front of the service didn't get an answer from it in time — the service is hanging or very slow.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі або шлюз перад сэрвісам не дачакаўся ад яго адказу — сэрвіс завіс або вельмі павольны."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy lub brama przed usługą nie doczekała się od niej odpowiedzi — usługa się zawiesiła lub działa bardzo wolno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси или шлюз перед сервисом не дождался от него ответа — сервис завис или очень медленный."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі або шлюз перед сервісом не дочекався від нього відповіді — сервіс завис або дуже повільний."
          }
        }
      }
    },
    "A proxy or gateway in front of the service got an invalid answer from it — the service behind it is often down or restarting.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі або шлюз перад сэрвісам атрымаў ад яго некарэктны адказ — часта сэрвіс за ім ляжыць або перазапускаецца."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy lub brama przed usługą otrzymała od niej niepoprawną odpowiedź — usługa za nią często nie działa lub się restartuje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси или шлюз перед сервисом получил от него некорректный ответ — часто сервис за ним лежит или перезапускается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі або шлюз перед сервісом отримав від нього некоректну відповідь — часто сервіс за ним лежить або перезапускається."
          }
        }
      }
    },
    "A site goes down": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт упаў"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona przestaje działać"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт упал"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт упав"
          }
        }
      }
    },
    "A site is back up": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт зноў даступны"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona znowu działa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт снова доступен"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт знову доступний"
          }
        }
      }
    },
    "A temporary redirect that keeps the same method and body.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовае перанакіраванне з тым жа метадам і целам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowe przekierowanie z tą samą metodą i treścią."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временное перенаправление с тем же методом и телом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасове перенаправлення з тим самим методом і тілом."
          }
        }
      }
    },
    "A temporary redirect to another address — often to a login page.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовае перанакіраванне на іншы адрас — часта на старонку ўваходу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowe przekierowanie pod inny adres — często na stronę logowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временное перенаправление на другой адрес — часто на страницу входа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасове перенаправлення на іншу адресу — часто на сторінку входу."
          }
        }
      }
    },
