    "To silence a single site, use the bell on its card.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Каб выключыць апавяшчэнні аднаго сайта, націсніце званочак на яго картцы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyciszyć jedną stronę, kliknij dzwonek na jej karcie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отключить уведомления одного сайта, нажмите колокольчик на его карточке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вимкнути сповіщення одного сайту, натисніть дзвіночок на його картці."
          }
        }
      }
    },
