    "1 failed check": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 неудачная проверка"
          }
        }
      }
    },
    "A joke code from an April Fools' RFC; some servers use it to reject bots.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шуточный код из первоапрельского RFC; некоторые серверы отвечают им ботам."
          }
        }
      }
    },
    "A permanent redirect that keeps the same method and body.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянное перенаправление с тем же методом и телом."
          }
        }
      }
    },
    "A proxy or gateway in front of the service didn't get an answer from it in time — the service is hanging or very slow.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси или шлюз перед сервисом не дождался от него ответа — сервис завис или очень медленный."
          }
        }
      }
    },
    "A proxy or gateway in front of the service got an invalid answer from it — the service behind it is often down or restarting.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси или шлюз перед сервисом получил от него некорректный ответ — часто сервис за ним лежит или перезапускается."
          }
        }
      }
    },
    "A site goes down": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт упал"
          }
        }
      }
    },
    "A site is back up": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт снова доступен"
          }
        }
      }
    },
    "A temporary redirect that keeps the same method and body.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временное перенаправление с тем же методом и телом."
          }
        }
      }
    },
    "A temporary redirect to another address — often to a login page.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временное перенаправление на другой адрес — часто на страницу входа."
          }
        }
      }
    },
    "Accepted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted"
