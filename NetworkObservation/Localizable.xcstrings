    "Local Network permission is required. Grant it in System Settings > Privacy & Security > Local Network.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны доступ да лакальнай сеткі. Дазвольце яго ў Сістэмных наладах > Прыватнасць і бяспека > Лакальная сетка."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest dostęp do sieci lokalnej. Przyznaj go w Ustawieniach systemowych > Prywatność i ochrona > Sieć lokalna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к локальной сети. Разрешите его в Системных настройках > Конфиденциальность и безопасность > Локальная сеть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до локальної мережі. Надайте його в Системних параметрах > Приватність і безпека > Локальна мережа."
          }
        }
      }
    },
