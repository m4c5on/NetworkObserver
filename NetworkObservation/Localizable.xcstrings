          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка TLS"
          }
        }
      }
    },
    "Temporary Redirect": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Redirect"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Redirect"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Redirect"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Redirect"
          }
        }
      }
    },
    "The address changed for good; the response points to the new one. Update the link to the new address.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрас зменены назаўжды; адказ паказвае новы. Абнавіце спасылку на новы адрас."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres zmienił się na stałe; odpowiedź wskazuje nowy. Zaktualizuj link na nowy adres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес изменился навсегда; ответ указывает новый. Обновите ссылку на новый адрес."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресу змінено назавжди; відповідь вказує нову. Оновіть посилання на нову адресу."
          }
        }
      }
    },
    "The cached copy is still valid, so the server sent no body.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія ў кэшы яшчэ актуальная, таму сервер не адправіў цела."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia w pamięci podręcznej jest wciąż aktualna, więc serwer nie wysłał treści."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия в кэше всё ещё актуальна, поэтому сервер не прислал тело."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія в кеші досі актуальна, тому сервер не надіслав тіло."
          }
        }
      }
    },
    "The path exists but doesn't accept this HTTP method — e.g. sending GET to an endpoint that only takes POST.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлях існуе, але не прымае гэты HTTP-метад — напрыклад, GET на endpoint, які прымае толькі POST."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżka istnieje, ale nie przyjmuje tej metody HTTP — np. GET do endpointu, który przyjmuje tylko POST."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь существует, но не принимает этот HTTP-метод — например, GET на endpoint, который принимает только POST."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлях існує, але не приймає цей HTTP-метод — наприклад, GET на endpoint, який приймає лише POST."
          }
        }
      }
    },
    "The request body is bigger than the server allows.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цела запыту большае, чым дазваляе сервер."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść żądania jest większa, niż pozwala serwer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тело запроса больше, чем разрешает сервер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіло запиту більше, ніж дозволяє сервер."
          }
        }
      }
    },
    "The request conflicts with the current state of the resource, e.g. a duplicate or an edit clash.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт канфліктуе з бягучым станам рэсурсу, напрыклад дублікат або адначасовая змена."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie jest sprzeczne z bieżącym stanem zasobu, np. duplikat lub równoczesna edycja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос конфликтует с текущим состоянием ресурса, например дубликат или одновременное изменение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит конфліктує з поточним станом ресурсу, наприклад дублікат або одночасна зміна."
          }
        }
      }
    },
    "The request reached the server, but the server failed while handling it. The problem is on the service side.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт дайшоў да сервера, але сервер зламаўся падчас яго апрацоўкі. Праблема на баку сэрвісу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie dotarło do serwera, ale serwer zawiódł podczas jego obsługi. Problem leży po stronie usługi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос дошёл до сервера, но сервер сломался при его обработке. Проблема на стороне сервиса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит дійшов до сервера, але сервер зламався під час його обробки. Проблема на боці сервісу."
          }
        }
      }
    },
    "The request succeeded and created a new resource. Usual for POST.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт выкананы, створаны новы рэсурс. Звычайна для POST."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie się powiodło i utworzyło nowy zasób. Typowe dla POST."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос выполнен и создал новый ресурс. Обычно для POST."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит виконано, створено новий ресурс. Зазвичай для POST."
          }
        }
      }
    },
    "The request succeeded and there is intentionally nothing in the response body. Usual for PATCH, PUT and DELETE.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт выкананы, а цела адказу наўмысна пустое. Звычайна для PATCH, PUT і DELETE."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie się powiodło, a treść odpowiedzi jest celowo pusta. Typowe dla PATCH, PUT i DELETE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос выполнен, а тело ответа намеренно пустое. Обычно для PATCH, PUT и DELETE."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит виконано, а тіло відповіді навмисно порожнє. Зазвичай для PATCH, PUT і DELETE."
          }
        }
      }
    },
    "The request was accepted for processing, which will finish later.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт прыняты ў апрацоўку, яна завершыцца пазней."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie przyjęto do przetworzenia, które zakończy się później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос принят в обработку, она завершится позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит прийнято в обробку, вона завершиться пізніше."
          }
        }
      }
    },
    "The request was well-formed but failed validation — e.g. a required field was missing. The endpoint itself is working.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт карэктны па форме, але не прайшоў праверку — напрыклад, не хапае абавязковага поля. Сам endpoint працуе."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie ma poprawną formę, ale nie przeszło walidacji — np. brakuje wymaganego pola. Sam endpoint działa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос корректный по форме, но не прошёл валидацию — например, не хватает обязательного поля. Сам endpoint работает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит коректний за формою, але не пройшов валідацію — наприклад, бракує обов'язкового поля. Сам endpoint працює."
          }
        }
      }
    },
    "The resource lives somewhere else; the response points to the new location.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэсурс знаходзіцца ў іншым месцы; адказ паказвае новы адрас."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasób jest gdzie indziej; odpowiedź wskazuje nowy adres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресурс находится в другом месте; ответ указывает новый адрес."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресурс розташований деінде; відповідь вказує нову адресу."
          }
        }
      }
    },
    "The resource was here but has been removed for good.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэсурс быў тут, але выдалены назаўжды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasób tu był, ale został usunięty na stałe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресурс был здесь, но удалён навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресурс був тут, але його видалено назавжди."
          }
        }
      }
    },
    "The result should be fetched from another address with GET.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вынік трэба забраць па іншым адрасе праз GET."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik należy pobrać spod innego adresu metodą GET."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат нужно забрать по другому адресу через GET."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат треба забрати за іншою адресою через GET."
          }
        }
      }
    },
    "The server can't produce a response in the format the request asked for.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не можа вярнуць адказ у фармаце, які запытаў кліент."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie może zwrócić odpowiedzi w formacie, o który prosi żądanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не может вернуть ответ в формате, который запросил клиент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не може повернути відповідь у форматі, який запросив клієнт."
          }
        }
      }
    },
    "The server crashed or hit an unhandled error while handling the request. The bug is in the service.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер упаў або атрымаў неапрацаваную памылку падчас апрацоўкі запыту. Памылка ў самім сэрвісе."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer uległ awarii lub trafił na nieobsłużony błąd podczas obsługi żądania. Błąd jest w samej usłudze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер упал или получил необработанную ошибку при обработке запроса. Ошибка в самом сервисе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер упав або отримав необроблену помилку під час обробки запиту. Помилка в самому сервісі."
          }
        }
      }
    },
    "The server doesn't accept the body's format — usually a wrong or missing Content-Type.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не прымае фармат цела — звычайна няправільны або адсутны Content-Type."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie przyjmuje formatu treści — zwykle błędny lub brakujący Content-Type."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не принимает формат тела — обычно неверный или отсутствующий Content-Type."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не приймає формат тіла — зазвичай неправильний або відсутній Content-Type."
          }
        }
      }
    },
    "The server doesn't support what the request needs, e.g. this method.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не падтрымлівае тое, што патрэбна запыту, напрыклад гэты метад."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie obsługuje tego, czego wymaga żądanie, np. tej metody."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не поддерживает то, что нужно запросу, например этот метод."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не підтримує те, що потрібно запиту, наприклад цей метод."
          }
        }
      }
    },
    "The server got the request headers and the client can send the body.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер атрымаў загалоўкі запыту, кліент можа адпраўляць цела."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer otrzymał nagłówki żądania, klient może wysłać treść."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер получил заголовки запроса, клиент может отправлять тело."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отримав заголовки запиту, клієнт може надсилати тіло."
          }
        }
      }
    },
    "The server got tired of waiting for the request to finish arriving.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не дачакаўся, пакуль запыт прыйдзе цалкам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie doczekał się, aż żądanie dotrze w całości."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не дождался, пока запрос придёт полностью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не дочекався, поки запит надійде повністю."
          }
        }
      }
    },
    "The server is switching to another protocol, e.g. WebSocket.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер пераключаецца на іншы пратакол, напрыклад WebSocket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer przełącza się na inny protokół, np. WebSocket."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер переключается на другой протокол, например WebSocket."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер перемикається на інший протокол, наприклад WebSocket."
          }
        }
      }
    },
    "The server is up and knows who you are (or doesn't care), but access to this resource is not allowed.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працуе і ведае, хто вы (або яму гэта не важна), але доступ да гэтага рэсурсу забаронены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer działa i wie, kim jesteś (lub go to nie obchodzi), ale dostęp do tego zasobu jest zabroniony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер работает и знает, кто вы (или ему это не важно), но доступ к этому ресурсу запрещён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працює і знає, хто ви (або йому це не важливо), але доступ до цього ресурсу заборонено."
          }
        }
      }
    },
    "The server is up but couldn't understand the request: a required parameter or body is missing or malformed.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працуе, але не зразумеў запыт: абавязковага параметра ці цела няма або яно некарэктнае."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer działa, ale nie zrozumiał żądania: brakuje wymaganego parametru lub treści albo są niepoprawne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер работает, но не понял запрос: обязательный параметр или тело отсутствует либо некорректно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працює, але не зрозумів запит: обов'язкового параметра чи тіла немає або воно некоректне."
          }
        }
      }
    },
    "The server is up but rejected the request itself — something about the request (URL, method, headers or body) is wrong for this endpoint.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працуе, але адхіліў сам запыт — нешта ў запыце (адрас, метад, загалоўкі ці цела) не падыходзіць для гэтага endpoint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer działa, ale odrzucił samo żądanie — coś w żądaniu (adres, metoda, nagłówki lub treść) nie pasuje do tego endpointu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер работает, но отклонил сам запрос — что-то в запросе (адрес, метод, заголовки или тело) не подходит для этого endpoint."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працює, але відхилив сам запит — щось у запиті (адреса, метод, заголовки чи тіло) не підходить для цього endpoint."
          }
        }
      }
    },
    "The server is up, but nothing exists at this path. Check the URL, or the route was removed or renamed.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працуе, але па гэтым шляху нічога няма. Праверце адрас — або маршрут выдалілі ці перайменавалі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer działa, ale pod tą ścieżką nic nie ma. Sprawdź adres — albo trasę usunięto lub zmieniono jej nazwę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер работает, но по этому пути ничего нет. Проверьте адрес — или маршрут удалили либо переименовали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працює, але за цим шляхом нічого немає. Перевірте адресу — або маршрут видалили чи перейменували."
          }
        }
      }
    },
    "The server is up, but the endpoint needs authentication and the request had no valid token or credentials. Without a token this is the normal answer for a protected API — add 401 to the accepted codes to treat it as \"online\".": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працуе, але endpoint патрабуе аўтарызацыі, а ў запыце няма сапраўднага токена ці ўліковых даных. Без токена гэта нармальны адказ абароненага API — дадайце 401 у дапушчальныя коды, каб лічыць яго «анлайн»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer działa, ale endpoint wymaga uwierzytelnienia, a żądanie nie miało ważnego tokena ani danych logowania. Bez tokena to normalna odpowiedź chronionego API — dodaj 401 do akceptowanych kodów, aby traktować ją jako „online”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер работает, но endpoint требует авторизацию, а в запросе нет действительного токена или учётных данных. Без токена это нормальный ответ защищённого API — добавьте 401 в допустимые коды, чтобы считать его «онлайн»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер працює, але endpoint потребує авторизації, а в запиті немає дійсного токена чи облікових даних. Без токена це нормальна відповідь захищеного API — додайте 401 до допустимих кодів, щоб вважати його «онлайн»."
          }
        }
      }
    },
    "The server received and handled the request successfully.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер атрымаў і паспяхова апрацаваў запыт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer otrzymał i poprawnie obsłużył żądanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер получил и успешно обработал запрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отримав і успішно обробив запит."
          }
        }
      }
    },
    "The service is temporarily unable to handle requests — overloaded, in maintenance or still starting.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сэрвіс часова не можа апрацоўваць запыты — перагружаны, на абслугоўванні або яшчэ запускаецца."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa chwilowo nie może obsługiwać żądań — jest przeciążona, w trakcie konserwacji lub jeszcze się uruchamia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис временно не может обрабатывать запросы — перегружен, на обслуживании или ещё запускается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервіс тимчасово не може обробляти запити — перевантажений, на обслуговуванні або ще запускається."
          }
        }
      }
    },
    "This URL is already being watched": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты адрас ужо адсочваецца"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres jest już obserwowany"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес уже отслеживается"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця адреса вже відстежується"
          }
        }
      }
    },
    "This is not a standard HTTP status code.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта нестандартны HTTP-код."
